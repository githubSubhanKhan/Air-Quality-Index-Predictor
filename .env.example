# Copy to .env and fill in. .env is git-ignored; this file is not, so never
# put real values here.

# --- Feature store / model registry ----------------------------------------
# MongoDB Atlas connection string. Both the aqi_features collection and the
# model registry (model_registry + the model_artifacts GridFS bucket) live in
# this one database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=aqi_predictor

# --- Data sources ----------------------------------------------------------
# OpenWeather: current + historical pollutants, and geocoding city -> lat/lon.
# This is the source the hourly pipeline and the backfill both use.
OPENWEATHER_API_KEY=

# WAQI: the original live source, still available via fetch_waqi.py but no
# longer on the pipeline's path.
WAQI_API_KEY=

# Open-Meteo (historical weather in the backfill) needs no key.

# --- Email alerts ----------------------------------------------------------
# The account the dashboard's "Send alert" button mails from.
#
# For Gmail, ALERT_SENDER_PASSWORD must be a 16-character App Password, not
# the account password — Google no longer accepts password sign-in for SMTP.
# Create one at: Google account -> Security -> 2-Step Verification ->
# App passwords. 2-Step Verification has to be on first.
#
# Other providers work too: set ALERT_SMTP_HOST/PORT accordingly. Port 587
# uses STARTTLS, port 465 switches to implicit SSL.
ALERT_SENDER_EMAIL=
ALERT_SENDER_PASSWORD=
ALERT_SENDER_NAME=AQI Predictor
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587

# --- Misc ------------------------------------------------------------------
APP_NAME=AQI Predictor
ENV=development
